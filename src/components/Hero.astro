---
/**
 * Custom Hero override for the splash template.
 * Extends Starlight's default Hero with:
 *  - a kicker line above the H1
 *  - three "pillar" summaries (See it / Enforce it / Ground it)
 *  - an install snippet shown directly beside the primary CTA
 *  - a quiet proof-line under the CTA row
 * Only src/content/docs/index.mdx uses `template: splash`, so the extra
 * copy below is intentionally hardcoded rather than added to the (schema
 * validated) hero frontmatter.
 */
import { Image } from 'astro:assets';
import { LinkButton } from '@astrojs/starlight/components';

// Starlight's internal PAGE_TITLE_ID constant isn't part of the public API surface;
// it is a fixed string ('_top') used to anchor the "Skip to content" link.
const PAGE_TITLE_ID = '_top';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, image, actions = [] } = data.hero || {};

const imageAttrs = {
	loading: 'eager' as const,
	decoding: 'async' as const,
	width: 400,
	height: 400,
	alt: image?.alt || '',
};

let darkImage: ImageMetadata | undefined;
let lightImage: ImageMetadata | undefined;
let rawHtml: string | undefined;
if (image) {
	if ('file' in image) {
		darkImage = image.file;
	} else if ('dark' in image) {
		darkImage = image.dark;
		lightImage = image.light;
	} else {
		rawHtml = image.html;
	}
}

const pillars = [
	{
		label: 'See it',
		copy: 'Doc\u2194code grounding, architecture visualization, hidden coupling detection. Evidence, not guesses.',
	},
	{
		label: 'Enforce it',
		copy: 'Structural, behavioral and semantic rules, checked in CI, extracted straight from your ADRs.',
	},
	{
		label: 'Ground it',
		copy: 'Give Copilot/Claude real context about your architecture instead of letting them guess.',
	},
];
---

<div class="hero">
	{
		darkImage && (
			<Image
				src={darkImage}
				{...imageAttrs}
				class:list={{ 'light:sl-hidden': Boolean(lightImage) }}
			/>
		)
	}
	{lightImage && <Image src={lightImage} {...imageAttrs} class="dark:sl-hidden" />}
	{rawHtml && <div class="hero-html sl-flex" set:html={rawHtml} />}
	<div class="sl-flex stack">
		<div class="sl-flex copy">
			<p class="kicker">Open source &middot; $0 core &middot; runs entirely on your machine</p>
			<h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />
			{tagline && <div class="tagline" set:html={tagline} />}
		</div>

		<div class="pillars">
			{
				pillars.map((pillar) => (
					<div class="pillar">
						<span class="pillar-label">{pillar.label}</span>
						<p>{pillar.copy}</p>
					</div>
				))
			}
		</div>

		<div class="cta-block">
			{
				actions.length > 0 && (
					<div class="sl-flex actions">
						{actions.map(
							({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
								<LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
									{text}
									{icon?.html && <Fragment set:html={icon.html} />}
								</LinkButton>
							)
						)}
					</div>
				)
			}
			<p class="quickstart">
				<code>npm install -g @intentweave/cli &amp;&amp; iw init</code>
			</p>
			<p class="proof-line">Zero LLM calls for indexing and enforcement. Add AI only when you choose to.</p>
		</div>
	</div>
</div>

<style>
	@layer starlight.core {
		.hero {
			display: grid;
			align-items: center;
			gap: 1rem;
			padding-bottom: 1rem;
		}

		.hero > img,
		.hero > .hero-html {
			object-fit: contain;
			width: min(70%, 20rem);
			height: auto;
			margin-inline: auto;
		}

		.stack {
			flex-direction: column;
			gap: clamp(1.5rem, calc(1.5rem + 1vw), 2rem);
			text-align: center;
		}

		.copy {
			flex-direction: column;
			gap: 1rem;
			align-items: center;
		}

		.copy > * {
			max-width: 50ch;
		}

		.kicker {
			margin: 0;
			font-size: var(--sl-text-sm);
			font-weight: 600;
			letter-spacing: 0.06em;
			text-transform: uppercase;
			color: var(--sl-color-accent-high, var(--sl-color-accent));
		}

		h1 {
			font-size: clamp(var(--sl-text-3xl), calc(0.25rem + 5vw), var(--sl-text-6xl));
			line-height: var(--sl-line-height-headings);
			font-weight: 600;
			color: var(--sl-color-white);
		}

		.tagline {
			font-size: clamp(var(--sl-text-base), calc(0.0625rem + 2vw), var(--sl-text-xl));
			color: var(--sl-color-gray-2);
			max-width: 60ch !important;
		}
	}

	.pillars {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
		gap: 1rem;
		width: 100%;
		max-width: 62rem;
		margin-inline: auto;
		text-align: start;
	}

	.pillar {
		border: 1px solid var(--sl-color-gray-5);
		background: var(--sl-color-bg-sidebar);
		border-radius: 0.5rem;
		padding: 1rem 1.25rem;
	}

	.pillar-label {
		display: block;
		font-weight: 600;
		color: var(--sl-color-accent-high, var(--sl-color-accent));
		margin-bottom: 0.35rem;
	}

	.pillar p {
		margin: 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}

	.cta-block {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
		width: 100%;
	}

	@layer starlight.core {
		.actions {
			gap: 1rem 2rem;
			flex-wrap: wrap;
			justify-content: center;
		}
	}

	.quickstart {
		margin: 0;
	}

	.quickstart code {
		font-size: var(--sl-text-sm);
		background: var(--sl-color-bg-sidebar);
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.35rem;
		padding: 0.35rem 0.75rem;
		color: var(--sl-color-gray-1);
	}

	.proof-line {
		margin: 0;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-4);
	}

	@media (min-width: 50rem) {
		@layer starlight.core {
			.hero {
				grid-template-columns: 7fr 4fr;
				gap: 3%;
				padding-block: clamp(2.5rem, calc(1rem + 10vmin), 10rem);
			}

			.hero > img,
			.hero > .hero-html {
				order: 2;
				width: min(100%, 25rem);
			}

			.stack {
				text-align: start;
			}

			.copy {
				align-items: flex-start;
			}
		}

		.pillars {
			text-align: start;
		}

		.cta-block {
			align-items: flex-start;
		}

		.actions {
			justify-content: flex-start !important;
		}
	}
</style>
